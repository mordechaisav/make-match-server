DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shadchan

# Path to the Firebase Admin SDK service account JSON (Project Settings ->
# Service Accounts -> Generate new private key). Never commit this file.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Groq API key (https://console.groq.com/keys), used to normalize
# candidate resume PDF field names before candidate-from-PDF create.
GROQ_API_KEY=

# Backblaze B2 (S3-compatible), used for candidate photo storage. The
# bucket is private - the server issues presigned upload/download URLs.
B2_ENDPOINT_URL=
B2_REGION=us-west-002
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
